    {
      "id": 11,
      "type": "timeseries",
      "title": "Duração das tasks por DAG (média)",
      "description": "Média desde o início do statsd-exporter. O p90 só aparece enquanto houver observações recentes (janela do exporter).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dag_id) (airflow_task_duration_sum{dag_id!=\"\", dag_id=~\"$dag_id\", task_id!=\"\"}) / sum by (dag_id) (airflow_task_duration_count{dag_id!=\"\", dag_id=~\"$dag_id\", task_id!=\"\"})",
          "legendFormat": "média {{dag_id}}",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (dag_id) (airflow_task_duration{quantile=\"0.9\", dag_id!=\"\", dag_id=~\"$dag_id\"})",
          "legendFormat": "p90 {{dag_id}}",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
